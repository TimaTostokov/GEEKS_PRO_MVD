<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.ui.fragments.documents.constitution.ConstitutionsSearchFragment">

    <LinearLayout
        android:id="@+id/ll_kr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_scrollFlags="scroll|enterAlways">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:src="@drawable/arrow_left"
            tools:ignore="ContentDescription" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/roboto"
            android:text="@string/laws"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <EditText
        android:id="@+id/et_search"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="120dp"
        android:background="@drawable/rounder_search"
        android:drawableStart="@drawable/search_line_sc"
        android:drawablePadding="8dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:freezesText="true"
        android:hint="@string/find"
        android:inputType="text"
        android:marqueeRepeatLimit="marquee_forever"
        android:padding="10dp"
        android:paddingEnd="40dp"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:textColor="@color/black"
        android:textColorHint="@color/black"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/ll_kr"
        tools:ignore="RtlSymmetry" />

    <ImageView
        android:id="@+id/delete_clear_btn"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignTop="@id/et_search"
        android:layout_alignEnd="@id/et_search"
        android:layout_alignBottom="@id/et_search"
        android:layout_gravity="end"
        android:layout_marginEnd="10dp"
        android:padding="6dp"
        android:src="@drawable/vector_exit"
        app:layout_constraintBottom_toBottomOf="@id/et_search"
        app:layout_constraintEnd_toEndOf="@id/et_search"
        app:layout_constraintTop_toTopOf="@id/et_search"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/btn_cross"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="34dp"
        android:layout_marginEnd="34dp"
        android:text="@string/cross"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@id/et_search"
        app:layout_constraintTop_toBottomOf="@id/ll_kr" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_laws_search"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="128dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/et_search"
        tools:listitem="@layout/item_laws" />

    <FrameLayout
        android:id="@+id/fcLawProgressBar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:visibility="gone">

        <include layout="@layout/progress_bar" />

    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>